{
  // Type check of the Task Management screens (src/tmx, TypeScript):  npm run typecheck
  // The rest of the app is plain JavaScript and is not checked here.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/tmx/**/*.ts", "src/tmx/**/*.tsx"]
}
